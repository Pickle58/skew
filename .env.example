NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

OXYLABS_WEB_API_KEY=
# Shared admin secret for x-skew-admin-secret on scrape/analyze/logs/sources (≥16 chars).
SKEW_ADMIN_SECRET=
OPENAI_API_KEY=
ANALYSIS_BATCH_SIZE=5

# CRON_SECRET is set in Vercel project settings only (not for local .env.local).
# Vercel sends Authorization: Bearer <CRON_SECRET> on cron invocations.
# CRON_SECRET=

# Local-only: set to 1 with NODE_ENV=development to call GET /api/cron/pipeline without CRON_SECRET.
# Never enable in production.
# ALLOW_INSECURE_CRON=1

# PostHog browser analytics
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
